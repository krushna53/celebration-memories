# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — base URL for absolute links/metadata/sitemap (lib/constants.ts's
# SITE_URL). Set this to your real production domain (e.g.
# https://everymoment.in) once you have one — falls back to a placeholder
# otherwise. Also drives Stripe/CCAvenue success/cancel/response URLs and
# the team-invite email's redirect link (services/admin-team.ts) — see
# docs/business-growth-guide.md's "Domains" section for the full custom
# domain checklist (DNS + Netlify + Supabase Auth Site URL).
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_, never import into client components
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Microsoft Clarity project ID (clarity.microsoft.com). Leave
# blank to skip; heatmaps/session recordings just won't load.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional — Resend API key (resend.com) for transactional email
# (inquiry + RSVP notifications). Leave blank to skip sending email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional — Cloudflare Turnstile CAPTCHA on the email sign-up form (/signup),
# free at dash.cloudflare.com → Turnstile. Leave both blank to skip the
# CAPTCHA. Local testing keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — OpenAI API key (platform.openai.com) for the AI Image admin
# tool (/admin/ai-image). Costs real money per image (see README). Leave
# blank and the page shows a "not configured" message instead of erroring.
OPENAI_API_KEY=
# Optional override — defaults to gpt-image-2 if unset.
OPENAI_IMAGE_MODEL=

# Optional — Stripe (dashboard.stripe.com) for the self-serve onboarding
# wizard's payment step (/start/[token]/payment). Leave all blank and
# that step shows a "not configured" message instead of erroring; every
# other wizard step works fine without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) from your Stripe product catalog — one for the
# one-time plan, one for the recurring subscription plan. Both are
# offered side by side on the payment step.
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_SUBSCRIPTION=

# Optional — Web Push (VAPID) for the guest reminder system: a browser/
# OS-level notification nudging a guest to finish a video/audio they
# started recording or uploading but never finished (see
# lib/push.ts and supabase/functions/send-reminder-push). Leave blank
# and the "Enable reminders" prompt just never shows — no error. The
# public key is safe to expose to the browser (it's what
# pushManager.subscribe() needs); the private key must stay server-only
# and is also set as a Supabase Edge Function secret (see
# supabase/README.md), not just here — Edge Functions don't read
# Netlify's env vars.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https:// URL identifying who's sending push
# messages, required by the Web Push protocol (RFC 8292).
VAPID_SUBJECT=

# Required for the daily admin-notification cron (feature nudges,
# storage warnings, post-event "new plans" prompts) — a shared secret
# checked by app/api/cron/admin-notifications/route.ts against the
# Authorization header pg_cron sends (see migration
# 0028_admin_notifications_cron.sql). Without it, that route always
# 401s and the daily jobs silently never run — the in-app notification
# panel and RSVP alerts still work fine either way, since those don't
# go through this route. The Event Mailer's birthday / work-anniversary
# automations use the same secret: schedule
#   POST /api/cron/mailer-automations  (Authorization: Bearer <CRON_SECRET>)
# hourly or daily — it sends nothing before 09:00 India time and never
# sends the same email twice.
CRON_SECRET=

# Optional — HeyGen API key (developers.heygen.com/docs/api-key) for the
# AI Timeline Movie admin tool (/admin/timeline-movie). Costs real money
# per generated video (see README). Also needs to be set separately as a
# Supabase Edge Function secret (`supabase secrets set HEYGEN_API_KEY=...`)
# for the two Edge Functions that actually submit/poll the render — this
# copy here is only for the avatar/voice picker, which runs in Next.js.
# Leave blank and the AI tab shows a "not configured" message instead of
# erroring; the "Upload your own video" tab works regardless.
HEYGEN_API_KEY=

# Optional — Razorpay (dashboard.razorpay.com), an alternative to Stripe
# for the wizard's payment step. Which processor is actually used is an
# owner-configurable setting (see /admin/billing) — having both sets of
# env vars filled in just means you can switch between them without a
# redeploy. Leave all blank and Razorpay simply won't be selectable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Recurring plan ID (plan_...) from Razorpay's Subscriptions -> Plans.
RAZORPAY_PLAN_SUBSCRIPTION=
# One-time price in the smallest currency unit — e.g. for INR, paise
# (999900 = ₹9,999).
RAZORPAY_AMOUNT_ONE_TIME=
RAZORPAY_CURRENCY=INR

# Optional — Google Photos / Google Drive import buttons on every upload.
# One OAuth "Web application" client (Google Cloud → APIs & Services →
# Credentials; add your site origins as Authorized JavaScript origins).
# Photos needs the Photos Picker API enabled. Drive additionally needs the
# Google Picker API + Google Drive API enabled, a browser API key
# restricted to the Picker API, and the Cloud project number. All of these
# are public values. Leave blank and the matching button simply doesn't show.
NEXT_PUBLIC_GOOGLE_PHOTOS_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# Cashfree Payment Gateway (server-only; prepared, not active until checkout wiring).
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Optional stable 32+ character key for saved Cashfree credentials; keep in server secrets.
# If omitted, encryption derives from SUPABASE_SERVICE_ROLE_KEY (rotation requires re-saving credentials).
CASHFREE_CREDENTIAL_ENCRYPTION_KEY=

# Optional — Corporate Event Mailer (/admin/mailer) backend. "mock" keeps
# all Mailer data in the browser's LocalStorage with demo data and only
# simulates sending (no database, no real email). "live" keeps Mailer data
# in Firebase and sends campaigns for real through a verified Email
# Configuration — it needs MAILER_EMAIL_CONFIG_STORE=firestore and the
# FIREBASE_* values below. Either way the page still needs an admin login.
NEXT_PUBLIC_MAILER_MODE=mock

# Required for Mailer → Email Settings (company SMTP passwords). A random
# string of 32+ characters, server-only — never prefix it with NEXT_PUBLIC_.
# SMTP passwords are encrypted with it before they reach the database, so
# losing or changing it makes saved passwords unreadable (admins re-enter
# them). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILER_CREDENTIAL_ENCRYPTION_KEY=
# Optional, for key rotation: the old key(s), comma-separated. Saved
# passwords encrypted with them still work and are re-encrypted with the
# new key the next time they're used.
MAILER_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Where Email Configuration is stored: "supabase" (default, needs migration
# 20261117120000_mailer_email_configs.sql) or "firestore" (needs the three
# FIREBASE_* values below, from a Firebase service account key).
MAILER_EMAIL_CONFIG_STORE=
# Dev only: "true" offers a "Local test (Mailpit)" provider (127.0.0.1:1025, no
# login, no TLS) so emails are caught locally instead of reaching real inboxes.
# Start Mailpit with: docker run -d --name mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit
# and read the caught emails at http://localhost:8025. Ignored outside `npm run dev`.
MAILER_ALLOW_LOCAL_SMTP=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# WhatsApp Cloud API (Meta's official Business Platform) — server-only,
# never NEXT_PUBLIC_. See docs/WHATSAPP_INTEGRATION.md. Nothing is sent
# unless WHATSAPP_ENABLED=true AND the owner switch in /admin/whatsapp is
# on; while WHATSAPP_TEST_MODE isn't "false", only the verified test
# recipients listed there receive anything.
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=true
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
