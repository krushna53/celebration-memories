# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — base URL for absolute links/metadata/sitemap (lib/constants.ts's
# SITE_URL). Set this to your real production domain (e.g.
# https://everymoment.in) once you have one — falls back to a placeholder
# otherwise. Also drives Stripe/CCAvenue success/cancel/response URLs and
# the team-invite email's redirect link (services/admin-team.ts) — see
# docs/business-growth-guide.md's "Domains" section for the full custom
# domain checklist (DNS + Netlify + Supabase Auth Site URL).
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_, never import into client components
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Microsoft Clarity project ID (clarity.microsoft.com). Leave
# blank to skip; heatmaps/session recordings just won't load.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional — Resend API key (resend.com) for transactional email
# (inquiry + RSVP notifications). Leave blank to skip sending email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional — OpenAI API key (platform.openai.com) for the AI Image admin
# tool (/admin/ai-image). Costs real money per image (see README). Leave
# blank and the page shows a "not configured" message instead of erroring.
OPENAI_API_KEY=
# Optional override — defaults to gpt-image-2 if unset.
OPENAI_IMAGE_MODEL=

# Optional — Stripe (dashboard.stripe.com) for the self-serve onboarding
# wizard's payment step (/start/[token]/payment). Leave all blank and
# that step shows a "not configured" message instead of erroring; every
# other wizard step works fine without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) from your Stripe product catalog — one for the
# one-time plan, one for the recurring subscription plan. Both are
# offered side by side on the payment step.
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_SUBSCRIPTION=

# Optional — Web Push (VAPID) for the guest reminder system: a browser/
# OS-level notification nudging a guest to finish a video/audio they
# started recording or uploading but never finished (see
# lib/push.ts and supabase/functions/send-reminder-push). Leave blank
# and the "Enable reminders" prompt just never shows — no error. The
# public key is safe to expose to the browser (it's what
# pushManager.subscribe() needs); the private key must stay server-only
# and is also set as a Supabase Edge Function secret (see
# supabase/README.md), not just here — Edge Functions don't read
# Netlify's env vars.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https:// URL identifying who's sending push
# messages, required by the Web Push protocol (RFC 8292).
VAPID_SUBJECT=

# Required for the daily admin-notification cron (feature nudges,
# storage warnings, post-event "new plans" prompts) — a shared secret
# checked by app/api/cron/admin-notifications/route.ts against the
# Authorization header pg_cron sends (see migration
# 0028_admin_notifications_cron.sql). Without it, that route always
# 401s and the daily jobs silently never run — the in-app notification
# panel and RSVP alerts still work fine either way, since those don't
# go through this route.
CRON_SECRET=

# Optional — Razorpay (dashboard.razorpay.com), an alternative to Stripe
# for the wizard's payment step. Which processor is actually used is an
# owner-configurable setting (see /admin/billing) — having both sets of
# env vars filled in just means you can switch between them without a
# redeploy. Leave all blank and Razorpay simply won't be selectable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Recurring plan ID (plan_...) from Razorpay's Subscriptions -> Plans.
RAZORPAY_PLAN_SUBSCRIPTION=
# One-time price in the smallest currency unit — e.g. for INR, paise
# (999900 = ₹9,999).
RAZORPAY_AMOUNT_ONE_TIME=
RAZORPAY_CURRENCY=INR
