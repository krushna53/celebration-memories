# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never import into client components
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Microsoft Clarity project ID (clarity.microsoft.com). Leave
# blank to skip; heatmaps/session recordings just won't load.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional — Resend API key (resend.com) for transactional email
# (inquiry + RSVP notifications). Leave blank to skip sending email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional — OpenAI API key (platform.openai.com) for the AI Image admin
# tool (/admin/ai-image). Costs real money per image (see README). Leave
# blank and the page shows a "not configured" message instead of erroring.
OPENAI_API_KEY=
# Optional override — defaults to gpt-image-2 if unset.
OPENAI_IMAGE_MODEL=
